# Daily sampling step: add the top 300 live channels to the tracked list, back up the
# database (keeping 2 copies), then restart the tracker so it picks up the new channels.
# Triggered by twitchnet-reseed.timer. Installed by deploy/setup_vm.sh.
[Unit]
Description=TwitchNet daily re-seed and backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/.venv/bin/python tracker.py --seed --live --limit 300
# Keep 2: the database grows to several GB as channels are added, and 7 copies would fill the disk
ExecStart=__REPO__/.venv/bin/python scripts/backup_db.py --keep 2
# "+" runs this step with full privileges, which restarting a system service needs
ExecStartPost=+/bin/systemctl restart twitchnet-tracker.service
